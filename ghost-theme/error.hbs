{{!< default}}

<div class="gc-layout gc-layout-full">
    <main class="gc-main">
        <div class="gc-box">
            <div class="gc-main-header">
                <span class="gc-filepath">root / system / error.log</span>
            </div>
            <div class="gc-error">
                <div class="gc-error-code">{{statusCode}}</div>
                <p class="gc-error-msg">{{message}}</p>
                <a class="gc-social-btn" href="{{@site.url}}">&#8592; back to safety</a>
            </div>
        </div>
    </main>
</div>
