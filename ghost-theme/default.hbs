<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{{meta_title}}</title>

    {{!-- Favicon — theme-provided p3 logo --}}
    <link rel="icon" type="image/png" href="{{asset "images/p3-logo.png"}}" />

    {{!-- Theme stylesheet. Linked explicitly because ghost_head does not inject it. --}}
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />

    {{!-- Apply saved color scheme before first paint to avoid a flash. Defaults to dark. --}}
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('gc-theme');
                document.documentElement.setAttribute('data-theme', saved || 'dark');
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>

    {{ghost_head}}
</head>
<body class="{{body_class}}">
    <div class="gc-desktop">

        {{!-- Window shell --}}
        <div class="win98">
            <div class="win98-titlebar">
                <div class="gc-titlebar-in">
                    {{!-- p3 image logo (white art; inverted in light mode via CSS) --}}
                    <a class="gc-logo" href="{{@site.url}}" aria-label="{{@site.title}} home">
                        <img src="{{asset "images/p3-logo.png"}}" alt="{{@site.title}}" class="gc-logo-img" />
                    </a>

                    <a class="win98-title" href="{{@site.url}}">{{@site.title}}</a>

                    <span class="win98-titlebar-actions">
                        <button class="gc-iconbtn" data-ghost-search type="button" aria-label="Search" title="Search">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </button>
                        <button class="gc-iconbtn gc-theme-toggle" data-theme-toggle type="button" aria-label="Toggle color scheme" title="Toggle light/dark">
                            <svg class="gc-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><line x1="12" y1="2" x2="12" y2="5"></line><line x1="12" y1="19" x2="12" y2="22"></line><line x1="2" y1="12" x2="5" y2="12"></line><line x1="19" y1="12" x2="22" y2="12"></line><line x1="4.9" y1="4.9" x2="7" y2="7"></line><line x1="17" y1="17" x2="19.1" y2="19.1"></line><line x1="4.9" y1="19.1" x2="7" y2="17"></line><line x1="17" y1="7" x2="19.1" y2="4.9"></line></svg>
                            <svg class="gc-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                        </button>
                    </span>
                </div>
            </div>

            <div class="win98-menubar">
                <div class="gc-menubar-in">
                    <a href="{{@site.url}}">Home</a>
                    <a href="https://qilstiano.github.io">About Me</a>
                    {{#foreach navigation}}
                        <a href="{{url}}">{{label}}</a>
                    {{/foreach}}
                    {{#foreach secondary_navigation}}
                        <a href="{{url}}">{{label}}</a>
                    {{/foreach}}
                </div>
            </div>

            <div class="win98-inner">
                <div class="gc-container">
                    {{{body}}}
                </div>
            </div>
        </div>

    </div>

    <script src="{{asset "js/theme.js"}}"></script>
    {{#is "post, index, tag, author, paged"}}<script src="{{asset "js/dither.js"}}"></script>{{/is}}
    {{#is "post, page"}}<script src="{{asset "js/reader.js"}}"></script>{{/is}}
    {{ghost_foot}}
</body>
</html>
